<odoo>

    <record id="view_wizard_stock_inventory_merge_form" model="ir.ui.view">
        <field name="model">wizard.stock.inventory.merge</field>
        <field name="arch" type="xml">
            <form>
                <group col="4">
                    <field name="name"/>
                </group>
                <footer>
                    <button name="action_merge" string="Merge Inventories" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_inventory_merge" model="ir.actions.act_window">
      <field name="name">Merge Inventories</field>
      <field name="res_model">wizard.stock.inventory.merge</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
      <field name="binding_model_id" ref="stock_inventory_mgmt.model_stock_inventory"/>
    </record>

</odoo>
