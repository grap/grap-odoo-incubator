<odoo>

    <record id="view_wizard_stock_inventory_merge_form" model="ir.ui.view">
        <field name="model">wizard.stock.inventory.merge</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="target_filter"/>
                    <div class="fst-italic text-muted" colspan="2">
                        <ul>
                            <li>Select <b>'<u>Partial</u>'</b> to merge various little inventories, for example, as part of a periodic inventory</li>
                            <li>Select <b>'<u>Complete Inventory</u>'</b> if you want to create a complete inventory, based on the selected inventories.<br/>The quantity of all the products that are not present in any selected inventories <b>will be reset to 0</b>.<br/>This option <b>should</b> be selected for the inventory created at the end of the fiscal period, and mandatory in an accounting point of view</li>
                        </ul>
                    </div>
                    <field name="name" attrs="{'readonly': [('target_filter', '=', False)]}" force_save="1"/>
                </group>
                <footer>
                    <button name="action_merge" string="Merge Inventories" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_inventory_merge" model="ir.actions.act_window">
      <field name="name">Merge Inventories</field>
      <field name="res_model">wizard.stock.inventory.merge</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
      <field name="binding_model_id" ref="stock_inventory_mgmt.model_stock_inventory"/>
    </record>

</odoo>
