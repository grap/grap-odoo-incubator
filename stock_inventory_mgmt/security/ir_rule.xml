<?xml version="1.0" encoding="UTF-8" ?>
<!-- Part of Odoo CE V12. LGPL. -->
<odoo>

    <record model="ir.rule" id="rule_stock_inventory">
        <field name="name">Inventory multi-company</field>
        <field name="model_id" ref="model_stock_inventory"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record model="ir.rule" id="rule_stock_inventory_line">
        <field name="name">Inventory Line multi-company</field>
        <field name="model_id" ref="model_stock_inventory_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record model="ir.rule" id="rule_stock_racking">
        <field name="name">Racking multi-company</field>
        <field name="model_id" ref="model_stock_racking"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

</odoo>
