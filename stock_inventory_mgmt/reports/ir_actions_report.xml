<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_stock_inventory_qweb" model="ir.actions.report">
        <field name="name">Inventory (PDF)</field>
        <field name="model">stock.inventory</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_inventory_mgmt.report_stock_inventory_qweb</field>
        <field name="report_file">stock_inventory_mgmt.report_stock_inventory_qweb</field>
        <field name="print_report_name">'Inventory - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_stock_inventory"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_stock_inventory_xlsx" model="ir.actions.report">
        <field name="name">Inventory (XLSX)</field>
        <field name="model">stock.inventory</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">stock_inventory_mgmt.report_stock_inventory_xlsx</field>
        <field name="report_file">stock_inventory_mgmt.report_stock_inventory_xlsx</field>
        <field name="print_report_name">'Inventory - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_stock_inventory"/>
    </record>

</odoo>
