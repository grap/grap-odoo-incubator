#. odoo-python
#: code:addons/sale_down_payment_product_per_company/wizards/sale_advance_payment_inv.py:0
#, python-format
msgid ""
"Unable to find a down payment product with taxes %(max_amount)s for the "
"company %(company_name)s. Please ask to your accountant to configure down "
"payments products."
msgstr ""
"Impossible de trouver un produit d'acompte avec une TVA de %(max_amount)s "
"pour la société %(company_name)s. Veuillez demander à votre comptable de "
"configurer les produits d'acompte."

#. module: sale_down_payment_product_per_company
#. odoo-python
#: code:addons/sale_down_payment_product_per_company/wizards/sale_advance_payment_inv.py:0
#, python-format
msgid ""
"Unable to find a down payment product without taxes for the company "
"%(company_name)s. Please ask to your accountant to configure down payments "
"products."
msgstr ""
"Impossible de trouver un produit d'acompte sans taxe pour la société "
"%(company_name)s. Veuillez demander à votre comptable de configurer les "
"produits d'acompte."

#. module: sale_down_payment_product_per_company
#. odoo-python
#: code:addons/sale_down_payment_product_per_company/wizards/sale_advance_payment_inv.py:0
#, python-format
msgid ""
"Unable to select a down payment product for sale orders related to many "
"companies. Please create down payments selecting sale orders of the single "
"company."
msgstr ""
"Impossible de sélectionner un produit d'acompte pour des ventes liées à des "
"sociétés différentes. Veuillez créer des acomptes en sélectionnant des "
"ventes d'une même société."
