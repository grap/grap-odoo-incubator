        <field name="type">service</field>
        <field name="taxes_id" eval="[
            Command.link(ref('sale_down_payment_product_per_company.vat_10')),
        ]"/>
    </record>

    <record id="product_down_payment_vat_20" model="product.product">
        <field name="name">Down Payment 20%</field>
        <field name="uom_id" ref="uom.product_uom_unit" />
        <field name="uom_po_id" ref="uom.product_uom_unit" />
        <field name="company_id" ref="base.main_company" />
        <field name="type">service</field>
        <field name="taxes_id" eval="[
            Command.link(ref('sale_down_payment_product_per_company.vat_20')),
        ]"/>
    </record>

</odoo>
