<?xml version="1.0" encoding="utf-8"?>
<template xml:space="preserve">

    <t t-name="MobileAppPurchaseSetQuantity" t-extend="MobileAppAbstract.GenericWidget">
        <t t-jquery=".place-holder" t-operation="append">
            <div class="row o_mobile_kiosk_abstract_row">
                <div class="mb0">
                    <h2><t t-esc="widget.mk_context.mk_purchase_supplier_name" /></h2>
                    <h3 class="secondary_information"><t t-esc="widget.mk_context.mk_purchase_order_name" />
                        <t t-if="widget.mk_context.mk_purchase_order_description"> - <t t-esc="widget.mk_context.mk_purchase_order_description" /></t>
                    </h3>
                    <h2><t t-esc="widget.mk_context.mk_purchase_product_name"/></h2>
                    <h3 class="secondary_information">
                        <t t-if="widget.mk_context.mk_purchase_supplierinfo_multiplier_qty">
                            Pack: <t t-esc="widget.mk_context.mk_purchase_supplierinfo_multiplier_qty"/>
                        </t>
                    </h3>
                    <hr />
                </div>
                <div class="placeholder-padwidget mb0"/>
                <div class="mb0">
                    <button class="btn btn-primary button_add_quantity">
                        <div class="mb8 mt8">Add quantity</div>
                    </button>
                </div>
            </div>
        </t>
    </t>

</template>
