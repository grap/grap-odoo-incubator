<odoo>

    <record id="view_hr_expense_form" model="ir.ui.view">
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='total_amount']" position="before">
                <label for="untaxed_amount" string="Total VAT Excl."/>
                <div class="o_row">
                    <field name="untaxed_amount" widget="monetary" options="{'currency_field': 'currency_id'}" class="oe_inline"/>
                </div>
                <label for="amount_tax" string="VAT Amount"/>
                <div class="o_row">
                    <field name="amount_tax" widget="monetary" options="{'currency_field': 'currency_id'}" class="oe_inline"/>
                    <span class="oe_inline" attrs="{'invisible': [('amount_tax', '=', 0)]}">Rate:</span>
                    <field name="tax_description" class="oe_inline" attrs="{'invisible': [('amount_tax', '=', 0)]}"/>
                </div>
            </xpath>

            <!-- Make total_amount label more explicit and always visible -->
            <xpath expr="//label[@for='total_amount']" position="attributes">
                <attribute name="string">Total VAT Incl.</attribute>
                <attribute name="attrs">{}</attribute>
            </xpath>

            <!-- Make total_amount field always visible -->
            <xpath expr="//field[@name='total_amount']/.." position="attributes">
                <attribute name="attrs">{}</attribute>
            </xpath>
            <field name="total_amount" position="attributes">
                <attribute name="attrs">{'readonly': ['|', ('sheet_is_editable', '=', False), ('product_has_cost', '=', True)]}</attribute>
            </field>

            <!-- Make total_amount_company label always hidden if currency are the sames -->
            <xpath expr="//label[@for='total_amount_company']" position="attributes">
                <attribute name="attrs">{'invisible': [('same_currency', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='label_convert_rate']/.." position="attributes">
                <attribute name="attrs">{'invisible': [('same_currency', '=', True)]}</attribute>
            </xpath>

            <!-- Hide VAT fields to avoid changes -->
            <xpath expr="//label[@for='tax_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='tax_ids']/../.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

</odoo>
