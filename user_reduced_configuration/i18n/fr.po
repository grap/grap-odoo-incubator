msgstr ""
"L'écran de reçu sera passé si le reçu peut être imprimé automatiquement. "

#. module: user_reduced_configuration
#: model:ir.model.fields,help:user_reduced_configuration.field_res_reduced_config_settings__pos_iface_print_auto
msgid "The receipt will automatically be printed at the end of each order."
msgstr "Le reçu sera automatiquement imprimé à la fin de chaque commande."

