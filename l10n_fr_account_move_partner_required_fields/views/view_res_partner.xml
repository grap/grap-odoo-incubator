<odoo>

    <!-- SIMPLE VIEW PARTNER FORM -->
    <!-- Add SIRET fields to be completed during invoice confirming step -->
    <record id="view_l10n_fr_account_move_res_partner_simple_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_simple_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mobile']" position="after">
                <field name="parent_is_company" invisible="1"/>
                <field name="company_type" invisible="1"/>
                <field
                    name="siren"
                    attrs="{'readonly': [('parent_id', '!=', False)], 'invisible': [('is_company', '=', False), ('parent_is_company', '=', False)], 'required': [('company_type', '=', 'company')]}"
                />
                <field
                    name="nic"
                    attrs="{'invisible': [('is_company', '=', False), ('parent_is_company', '=', False)]}"
                />
                <field name="siret" attrs="{'readonly': [('parent_id', '!=', False)], 'invisible': [('is_company', '=', False), ('parent_is_company', '=', False)]}" placeholder="SIREN + NIC"/>
            </xpath>
        </field>
    </record>

    <!-- CLASSIC VIEW PARTNER FORM -->
    <!-- Move SIRET fields to be more visible -->
    <record id="view_l10n_fr_account_move_res_partner_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="l10n_fr_siret.res_partner_form_l10n_fr" />
        <field name="arch" type="xml">
            <div role="alert" position="after">
                <div
                    class="alert alert-warning"
                    role="alert"
                    attrs="{'invisible': ['|', ('is_company', '=', False),'&amp;', ('is_company', '=', True), ('siren', '!=', False)]}"
                >The SIREN number will be required when invoicing this company.</div>
                <div
                    class="alert alert-warning"
                    role="alert"
                    attrs="{'invisible': ['|', ('is_company', '=', False),'&amp;', '&amp;', '&amp;', ('is_company', '=', True), ('street', '!=', False), ('zip', '!=', False), ('city', '!=', False)]}"
                >Address (street, zip, city) will be required when invoicing this company.</div>
            </div>

        </field>
    </record>


</odoo>
