<odoo>

    <record id="view_account_move" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">

            <xpath expr="//button[@name='button_set_checked']" position="after">
                <field name="stock_picking_could_be_adjusted" invisible="1"/>
                <button name="adjust_stock_picking"
                    string="Adjust Stock Picking" data-hotkey="r"
                    type="object"
                    attrs="{'invisible': [('stock_picking_could_be_adjusted', '=', False)]}"
                    confirm="This will generate Stock Picking Returns if you invoice for less than the quantity specified in the Sale Order, and Pickings if you invoice for more."
                />
            </xpath>


            <div role="alert" position="after">
                <div class="alert alert-warning mb-0" role="alert" attrs="{'invisible': [('stock_picking_could_be_adjusted', '=', False)]}">
                    Adjust stock with <b>Adjust Stock Picking</b> button. It will create Stock Picking and or Return Stock Picking according to quantity differentials.
                </div>
            </div>

        </field>
    </record>

</odoo>
