#. module: account_move_reversal_stock
#: model_terms:ir.ui.view,arch_db:account_move_reversal_stock.view_account_move
msgid ""
"Adjust stock with <b>Reverse Stock Picking</b> button. It will create a <b>Return</b> Stock Picking\n"
"                    <b>\n"
"                        <span attrs=\"{'invisible': [('move_type', '=', 'out_invoice')]}\">\n"
"                            with theses new quantities.\n"
"                        </span>\n"
"                        <span attrs=\"{'invisible': [('move_type', '=', 'out_refund')]}\">\n"
"                            with quantity differentials.\n"
"                        </span>\n"
"                    </b>"
msgstr ""
"Ajuster les stocks avec le bouton <b>Retourner les Mouvements de Stock</b>. Cela créera un <b>Retour</b> de mouvement de stock\n"
"                    <b>\n"
"                        <span attrs=\"{'invisible': [('move_type', '=', 'out_invoice')]}\">\n"
"                            avec ces nouvelles quantités.\n"
"                        </span>\n"
"                        <span attrs=\"{'invisible': [('move_type', '=', 'out_refund')]}\">\n"
"                            avec le différentiel de quantités.\n"
"                        </span>\n"
"                    </b>"

