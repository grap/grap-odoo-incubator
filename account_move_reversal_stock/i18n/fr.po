#. module: account_move_reversal_stock
#: model_terms:ir.ui.view,arch_db:account_move_reversal_stock.view_account_move
msgid "Adjust Stock Picking"
msgstr "Ajuster les Mouvements de Stock"

#. module: account_move_reversal_stock
#: model_terms:ir.ui.view,arch_db:account_move_reversal_stock.view_account_move
msgid ""
"Adjust stock with <b>Adjust Stock Picking</b> button. It will create Stock "
"Picking and or Return Stock Picking according to quantity differentials."
msgstr ""
"Ajuster le stock avec le bouton <b>Ajuster les Mouvements de Stock</b>. Cela "
"créera un Bon de Livrason et/ou un Retour de Bon de livraison selon les "
"différences de quantité facturées."

