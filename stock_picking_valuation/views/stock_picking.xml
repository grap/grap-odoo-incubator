<odoo>

    <record id="view_stock_picking_form" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity_done']" position="after">
                <field name="unit_valuation" optional="show"/>
                <field name="total_valuation" optional="hide" sum="Total Valuation"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_picking_tree" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                 <field name="total_valuation" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
