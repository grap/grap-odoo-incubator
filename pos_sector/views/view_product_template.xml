<odoo>

    <record id="view_product_template_search" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_search_view_pos"/>
        <field name="arch" type="xml">
            <filter name="filter_to_availabe_pos" position="after">
                <field name="sector_id" />
            </filter>
        </field>
    </record>

    <record id="view_product_template_tree" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="pos_categ_id" position="after">
                <field name="sector_id" optional="hide" />
            </field>
        </field>
    </record>

    <record id="view_product_template_form" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="available_in_pos" position="after">
                <field name="sector_id" string="Sector"/>
            </field>
        </field>
    </record>

</odoo>
