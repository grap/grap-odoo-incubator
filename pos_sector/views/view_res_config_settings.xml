<odoo>

    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='pos_iface_big_scrollbars']/../.."
                position="after"
            >
                <div class="col-12 col-lg-6 o_setting_box" id="sectors">
                    <div class="o_setting_left_pane">
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="pos_sector_ids"/>
                        <div class="mb16">
                            <field name="pos_sector_ids" widget="many2many_tags"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
